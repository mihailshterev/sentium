{
  "name": "sentium-e2e",
  "version": "1.0.0",
  "description": "Playwright end-to-end suite for Sentium",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose -f compose.e2e.yaml up -d --wait",
    "infra:down": "docker compose -f compose.e2e.yaml down --volumes --remove-orphans",
    "infra:logs": "docker compose -f compose.e2e.yaml logs --no-color",
    "install:browsers": "playwright install --with-deps"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "private": true
}
