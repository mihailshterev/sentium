<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Modules carry ASP.NET controllers that used to live in Microsoft.NET.Sdk.Web projects; give them the same implicit usings. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!--
    A module's public surface is its Contracts namespace plus its *ModuleExtensions; everything else is internal.
    E2ESeed writes seed data straight into module DbContexts, and DynamicProxyGenAssembly2 lets NSubstitute mock
    internal interfaces.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sentium.Tests.Unit" />
    <InternalsVisibleTo Include="Sentium.Tests.Integration" />
    <InternalsVisibleTo Include="Sentium.E2ESeed" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
