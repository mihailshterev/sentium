# Sentium - Docker Compose configuration
# ----------------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values before running `docker compose up`.
#   bash / macOS / Linux : cp .env.example .env
#   PowerShell (Windows) : Copy-Item .env.example .env
#
# Only the values under "Secrets" strictly need changing for a local run; everything
# else has a sensible default. See docs/installation.md for the full walkthrough.
# ----------------------------------------------------------------------------------

# --- Secrets (CHANGE THESE) -------------------------------------------------------
# Each secret should be a unique, random value. Generate one with:
#   bash / macOS / Linux : openssl rand -base64 32
#   PowerShell (Windows) : [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))

# PostgreSQL 'postgres' superuser password. Every module keeps its own schema in the one
# 'sentiumdb' database.
POSTGRES_PASSWORD=change-me-postgres-password

# Pre-shared key sentium-web sends to the sandbox and backup services (the X-Internal-Token header).
# All three containers read the same value; the sidecars reject sentium-web's calls if it is empty or differs.
INTERNAL_API_KEY=change-me-internal-api-key

# Bearer token the llama.cpp inference servers (llm, embeddings) require from sentium-web.
# Every request except /health is rejected without it.
LLM_API_KEY=change-me-llm-api-key

# Secret key of the bundled SearXNG instance (the web-search MCP server's backend, see docs/mcp-servers.md).
SEARXNG_SECRET=change-me-searxng-secret

# --- LAN access (HTTPS) ------------------------------------------------------------
# The caddy service serves the portal at https://SENTIUM_HOSTNAME with a certificate from its own
# per-installation certificate authority. Point the name at this host (router DNS or hosts file) and
# trust the CA on each device - see "LAN access" in docs/installation.md.

# Hostname devices use to reach Sentium. Several names are allowed, comma-separated
# (for example "sentium.home.arpa, localhost").
SENTIUM_HOSTNAME=sentium.home.arpa

# Host ports caddy is published on. Port 80 only redirects to HTTPS. With a non-default HTTPS port,
# include it in the URL (https://sentium.home.arpa:8443).
HTTP_PORT=80
HTTPS_PORT=443

# --- Models (llama.cpp) -----------------------------------------------------------
# Model files are declared in infra/llm/models.lock (pinned by checksum) and downloaded
# into the shared `sentium-llm-models` volume on first run by the models-init container.
# SENTIUM_MODEL is the default chat model: a section name in infra/llm/models.ini.
# SENTIUM_EMBEDDING_MODEL names the embedding model the embeddings server runs; change it
# whenever you change that model, so stored knowledge is re-embedded. It must stay
# 768-dimensional to match the RAG vector size. The defaults mirror the Aspire AppHost.

SENTIUM_MODEL=gemma-4-e4b
SENTIUM_EMBEDDING_MODEL=embeddinggemma-2

# Optional Hugging Face token, only needed if you add a model from a gated repository.
HF_TOKEN=

# --- Speech (Companion voice) ------------------------------------------------------
# Push-to-talk and spoken replies use two CPU-only containers: `whisper` (speech-to-text) and `tts`
# (text-to-speech, a ~5 GB image). sentium-web starts without them, and the portal hides its voice
# controls while they are down. To run without speech, uncomment both lines (empty = switched off)
# and start with: docker compose up -d --scale whisper=0 --scale tts=0

# SPEECH_TRANSCRIPTION_ENDPOINT=
# SPEECH_SYNTHESIS_ENDPOINT=

# --- Sandbox ----------------------------------------------------------------------

# Per-job working directory for the code sandbox. Because the sandbox spawns sibling worker
# containers via the host Docker daemon, this path must be IDENTICAL on the host and inside the
# sandbox container (the value is used as both the bind source and target). On Windows, use a
# path inside your WSL2 distro.
SANDBOX_JOBS_DIR=/tmp/sentium-sandbox

# --- MCP servers (Model Context Protocol) -----------------------------------------
# Sovereign users register MCP servers in the portal (AI & automation > MCP servers). HTTP servers
# must be on the local network. Stdio servers run inside the sandbox as hardened containers built
# from pre-baked, digest-pinned images - see docs/mcp-servers.md.

# Let the sandbox run stdio MCP server containers.
SANDBOX_MCP_ENABLED=false

# Docker network MCP containers may join (otherwise they get no network at all). The default is the
# `internal: true` network compose creates, shared with the bundled searxng service. Use only internal
# networks: Docker cannot restrict a container's egress to the local network.
SANDBOX_MCP_ALLOWED_NETWORK=sentium-egress

# --- Backups ----------------------------------------------------------------------
# The backup service writes a verified archive of the database, blobs and data-protection keys every night.
# See "Backups" in docs/installation.md. Create the marker file once in the destination, so an unmounted NAS
# share is reported instead of silently backed up to the local disk:
#   touch "$BACKUP_DESTINATION/.sentium-backups"

# Host directory the archives go to, typically a NAS mount. Defaults to ./backups next to this file.
# BACKUP_DESTINATION=/mnt/nas/sentium-backups

# Local time of the nightly run, in BACKUP_TIMEZONE (an IANA name such as Europe/Sofia).
BACKUP_TIME=03:00
BACKUP_TIMEZONE=UTC

# Retention: the newest backup of each of the last N days and of each of the last N ISO weeks.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Optional: encrypt archives to this age public key (age1...). Keep the matching identity file OFF this host;
# a restore needs it. Generate a pair with `age-keygen -o sentium-backup.key`. Empty = unencrypted archives.
BACKUP_AGE_RECIPIENT=

# --- Blob storage (Azurite emulator, well-known dev credentials) ------------------
# These are Azurite's public, well-known development credentials - safe to commit and
# the same ones the Aspire emulator uses. Only the blob endpoint is used by Sentium.

AZURITE_CONNECTION=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
